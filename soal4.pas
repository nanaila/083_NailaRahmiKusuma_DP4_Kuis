program soal4;
uses crt;
var
    n, i, : integer;
    rata : real;
begin
    clrscr;
    jumlah := 0
    write('Masukkan nilai: ');
    readln(n);
    for i := 1 to n do

    rata := jumlah/n

    if n < 0 then
    write ('MINIMUM');
    if else n > 100 then
    write ('MAKSIMUM');

    writeln;
    writeln ('Nilai Minimum : ', MINIMUM );
    writeln('Nilai Maksimum : ', MAKSIMUM);
    writeln('Rata-Rata : ', rata:0:2);
    readln;
end.